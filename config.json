{
  "name": "beta: Actron Que/Neo Air Conditioner",
  "version": "2025.9.0q1",
  "slug": "hass-actronque-beta",
  "description": "An add-on for Actron Air Conditioners using the Actron Que or Neo modules.",
  "url": "https://github.com/DanielNagy/hass-actronque",
  "startup": "application",
  "boot": "auto",
  "arch": ["amd64", "aarch64", "armv7"],
	"options": {
		"MQTTUser": "",
		"MQTTPassword": "",
		"MQTTBroker": "core-mosquitto",
		"MQTTLogs": true,
		"MQTTTLS": false,
		"PerZoneControls": false,
		"PollInterval": 45,
		"QueUser": "queuser",
		"QueLogs": true,
		"QuePassword": "quepassword",
		"SeparateHeatCoolTargets": false
	},
	"schema": {
		"MQTTUser": "str?",
		"MQTTPassword": "str?",
		"MQTTBroker": "str",
		"MQTTLogs": "bool?",
		"MQTTTLS": "bool?",
		"PerZoneControls": "bool",
		"PollInterval": "int(10,300)",
		"QueUser": "str",
		"QueLogs": "bool?",
		"QuePassword": "str",
		"QueSerial": "str?",
		"SeparateHeatCoolTargets": "bool?"
	}
}
